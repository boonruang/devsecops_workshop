# bash setup.sh สร้าง .env จากไฟล์นี้ให้ (หา IP + สุ่มรหัส) หรือคัดลอกเป็น .env แล้วแก้เองอย่างน้อย LAB_HOST
#
# LAB_HOST ต้องเป็น IP ของเครื่องที่รัน workshop ที่เบราว์เซอร์เรียกถึง (bash setup.sh หาให้เอง)
# ห้ามใช้ localhost เพราะ GitLab ใช้สร้าง clone URL และ deploy-host ใช้ pull image จาก registry
LAB_HOST=192.168.1.50

# ---- GitLab ----
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224
# web login http://LAB_HOST:8929  user: root
# GitLab ตั้งรหัสนี้ให้ root ตอนเปิดครั้งแรก (volume ว่าง) ต้องยาว 8 ตัวขึ้นไปและไม่ใช่คำง่ายๆ ไม่งั้น GitLab ไม่รับ
GITLAB_ROOT_USER=root
GITLAB_ROOT_PASSWORD=change-me-to-a-long-random-password

# ---- Jenkins (ตั้งค่าผ่าน JCasC ไม่มีหน้า setup wizard) ----
JENKINS_HTTP_PORT=8080
# web login http://LAB_HOST:8080  ใช้ JENKINS_ADMIN_ID / JENKINS_ADMIN_PASSWORD (JCasC ตั้งให้ทุกครั้งที่เปิด)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=workshop-change-me

# ---- SonarQube ----
SONAR_HTTP_PORT=9000
SONAR_DB_PASSWORD=sonar-change-me
# เพื่อทราบ: web login http://LAB_HOST:9000 (compose ไม่ได้อ่านค่านี้)
# เปิดครั้งแรกเป็น admin/admin แล้ว SonarQube บังคับให้ตั้งรหัสใหม่ จดค่าที่ตั้งไว้ตรงนี้
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASSWORD=change-me

# ---- Trivy ----
TRIVY_SERVER_PORT=4954

# ---- BuildKit registry (ที่เก็บ image ให้ deploy-host pull) ----
REGISTRY_PORT=5000

# ---- Vault (server mode เก็บลง volume, unseal เองตอนเปิด) ----
# web login http://LAB_HOST:8200  Method: Token ใส่ VAULT_ROOT_TOKEN (Vault ไม่มี user/password)
VAULT_PORT=8200
VAULT_ROOT_TOKEN=root-workshop-change-me
# AppRole ที่ Jenkins ใช้ login เข้า Vault (กำหนดตายตัวเพื่อให้ restart แล้ว credential ใน Jenkins ยังใช้ได้)
VAULT_JENKINS_ROLE_ID=jenkins-workshop-role
VAULT_JENKINS_SECRET_ID=jenkins-workshop-secret-change-me

# ---- sample-app (web app ที่ deploy เป็น container บน deploy-host แยกตาม env) ----
# ไม่มีหน้า login หน้าแรกแสดง env, version และ sha256 ของ secret ที่ได้จาก Vault
# web dev http://LAB_HOST:8088 (branch develop) · uat http://LAB_HOST:8089 (branch uat) · prd http://LAB_HOST:8090 (git tag)
WEBAPP_PORT_DEV=8088
WEBAPP_PORT_UAT=8089
WEBAPP_PORT_PRD=8090
# Trivy, BuildKit, registry, deploy-host ไม่มีหน้าเว็บ

# ---- Harbor (profile harbor แยกจาก all) ----
# web login http://LAB_HOST:8085  user: admin  รหัส HARBOR_ADMIN_PASSWORD (ตั้งให้ตอนเปิดครั้งแรก)
# เปลี่ยนค่าหลังเปิดไปแล้วต้องรัน bash harbor/prepare.sh ใหม่ และรหัส admin เปลี่ยนในหน้าเว็บเท่านั้น
HARBOR_HTTP_PORT=8085
HARBOR_ADMIN_PASSWORD=Harbor-change-me-1
HARBOR_DB_PASSWORD=harbor-db-change-me

# ---- deploy-host ----
# วง IP ของ docker0 ข้างใน deploy-host ต้องไม่ทับวงที่ LAB_HOST อยู่ ไม่งั้น pull image จาก LAB_HOST:5000 ไม่ได้ (no route to host)
# DEPLOY_HOST_BIP=172.31.255.1/24
